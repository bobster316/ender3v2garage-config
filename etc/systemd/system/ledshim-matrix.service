[Unit]
Description=Matrix Pi LED SHIM Animation
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/home/pi/matrix-pi
ExecStart=/home/pi/matrix-pi/.venv/bin/python /home/pi/matrix-pi/ledshim_matrix.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
